{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "lib/**/*",
    "usage-aggregation/src/**/*",
    "health-monitoring/src/**/*",
    "payment-verification/src/**/*",
    "ai-api-analyzer/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
