{
  "name": "@opengrant/cli",
  "version": "0.1.0",
  "description": "OpenGrant CLI - Manage API monetization, USDC payments, and OSS funding from the terminal",
  "bin": {
    "opengrant": "dist/index.js"
  },
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opengrant/sdk": "^0.1.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "conf": "^13.0.1",
    "inquirer": "^13.2.0",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "opengrant",
    "cli",
    "api",
    "monetization",
    "x402",
    "usdc",
    "crypto",
    "micropayments",
    "base",
    "blockchain",
    "evm",
    "open-source",
    "funding",
    "escrow",
    "donate",
    "web3"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qvkare/opengrant.git"
  },
  "homepage": "https://opengrant.dev",
  "bugs": {
    "url": "https://github.com/qvkare/opengrant/issues"
  },
  "license": "MIT"
}
