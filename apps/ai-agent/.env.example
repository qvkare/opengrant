# OpenGrant API Key (from publisher dashboard)
OPENGRANT_API_KEY=og_live_xxx

# Private key for wallet (x402 payment signing)
PRIVATE_KEY=

# Anthropic API Key (for Claude AI)
ANTHROPIC_API_KEY=

# Chain ID (84532 = Base Sepolia)
CHAIN_ID=84532

# OpenGrant API URL (default: https://api.opengrant.dev)
OPENGRANT_API_URL=http://localhost:3001

# Demo API URL (the code-scanner API to call)
DEMO_API_SLUG=code-scanner
