{
  "name": "@opengrant/sdk",
  "version": "1.1.0",
  "description": "OpenGrant SDK - Pay for APIs with USDC micropayments using the x402 protocol",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "keywords": [
    "opengrant",
    "sdk",
    "api",
    "micropayments",
    "x402",
    "crypto",
    "usdc",
    "base",
    "blockchain",
    "evm",
    "open-source",
    "funding",
    "escrow",
    "donate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qvkare/opengrant.git"
  },
  "homepage": "https://opengrant.dev",
  "bugs": {
    "url": "https://github.com/qvkare/opengrant/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
