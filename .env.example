# ===========================================
# OpenGrant Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# -----------------
# Server
# -----------------
NODE_ENV=development
PORT=3001

# -----------------
# Database (PostgreSQL)
# -----------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/opengrant

# -----------------
# Redis (for rate limiting, caching, and sessions)
# -----------------
REDIS_URL=redis://localhost:6379

# -----------------
# Blockchain
# -----------------
# Base Mainnet
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org

# Base Sepolia (testnet) - uncomment for testing
# CHAIN_ID=84532
# RPC_URL=https://sepolia.base.org

# Platform wallet private key (for settlements and withdrawals)
# WARNING: Keep this secure! Only needed for production settlement processing
PLATFORM_PRIVATE_KEY=

# -----------------
# x402 Payment Protocol
# -----------------
X402_FACILITATOR_URL=https://x402.org/facilitator
PLATFORM_WALLET=0xYourPlatformWalletAddress

# -----------------
# Contract Addresses (set after deployment)
# -----------------
OPENGRANT_REGISTRY_ADDRESS=
OPENGRANT_PAYMENTS_ADDRESS=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# -----------------
# Authentication
# -----------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# -----------------
# URLs
# -----------------
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Landing page -> app URL (used by landing to link to app)
NEXT_PUBLIC_APP_URL=https://app.opengrant.dev
# App -> landing URL (used by web app logo to link back to landing)
NEXT_PUBLIC_LANDING_URL=https://opengrant.dev

# -----------------
# Particle Network (Web Auth)
# -----------------
NEXT_PUBLIC_PARTICLE_PROJECT_ID=your-particle-project-id
NEXT_PUBLIC_PARTICLE_CLIENT_KEY=your-particle-client-key
NEXT_PUBLIC_PARTICLE_APP_ID=your-particle-app-id

# -----------------
# Coinbase (Onramp)
# -----------------
NEXT_PUBLIC_COINBASE_APP_ID=your-coinbase-app-id

# -----------------
# Chainlink CRE (optional)
# -----------------
CRE_DON_ID=
CRE_WORKFLOW_ID=

# -----------------
# Contract Deployment (for Foundry)
# -----------------
# Deployer private key (for contract deployment only)
PRIVATE_KEY=your-deployer-private-key
ETHERSCAN_API_KEY=
