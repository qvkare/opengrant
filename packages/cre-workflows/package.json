{
  "name": "@opengrant/cre-workflows",
  "version": "0.1.0",
  "description": "Chainlink CRE workflows for OpenGrant: usage aggregation, health monitoring, and payment verification.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "simulate:usage": "cre workflow simulate ./usage-aggregation",
    "simulate:health": "cre workflow simulate ./health-monitoring",
    "simulate:payment": "cre workflow simulate ./payment-verification",
    "deploy:usage": "cre workflow deploy ./usage-aggregation",
    "deploy:health": "cre workflow deploy ./health-monitoring",
    "deploy:payment": "cre workflow deploy ./payment-verification"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "^1.0.9",
    "@chainlink/cre-sdk-javy-plugin": "^1.0.9"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.6.3",
    "@types/node": "^22.13.0",
    "typescript": "^5.9.3"
  }
}
